# Salin file ini jadi ".env" untuk testing di komputer sendiri (opsional).
# Di Render, JANGAN upload file .env — masukkan variable ini lewat
# menu "Environment" di dashboard Render.

GROQ_API_KEY=isi_dengan_api_key_groq_kamu

# --- Opsional untuk Studio Foto AI ---
# Tanpa kunci pun gambar tetap jalan (batas lebih ketat, kadang ada watermark).
# Daftar gratis di https://enter.pollinations.ai untuk limit lebih longgar:
# POLLINATIONS_KEY=isi_kunci_pollinations
# IMAGE_MODEL=flux
